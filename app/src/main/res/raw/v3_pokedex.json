{
  "schemaVersion": 3,
  "name": "KANTO POKÉDEX",
  "icon": "⚡",
  "version": "1.0",
  "author": "Appkin",
  "changelog": "A Pokédex for the original 151 Pokémon. Catalog data comes from the open PokemonGO-Pokedex dataset, with artwork provided by the PokéAPI sprites repository.",
  "mainView": {
    "id": "pokedex_home",
    "type": "layout",
    "views": [
      {
        "type": "text",
        "label": "Kanto Pokédex",
        "title": "Explore the original 151 Pokémon. Tap a Pokémon to open its full entry.",
        "textStyle": "bold",
        "textSize": 18
      },
      {
        "type": "list",
        "mapping": "pokemon",
        "initData": {
          "url": "https://raw.githubusercontent.com/Biuni/PokemonGO-Pokedex/master/pokedex.json",
          "method": "get"
        },
        "action": {
          "id": "show_pokemon_detail"
        },
        "itemView": {
          "id": "pokemon_list_item",
          "type": "layout",
          "orientation": "horizontal",
          "views": [
            {
              "type": "image",
              "url": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png",
              "size": {
                "width": 112,
                "height": 112
              }
            },
            {
              "type": "text",
              "label": "#${num}  ${name}",
              "title": "Type: ${type}\n${height}  •  ${weight}"
            }
          ]
        }
      },
      {
        "type": "text",
        "title": "Data: PokemonGO-Pokedex • Artwork: PokéAPI sprites",
        "textStyle": "italic"
      }
    ]
  },
  "views": [
    {
      "id": "pokemon_detail",
      "type": "layout",
      "views": [
        {
          "type": "image",
          "url": "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png",
          "size": {
            "height": 300
          }
        },
        {
          "type": "text",
          "label": "#${num}  ${name}",
          "title": "${type}",
          "textStyle": "bold",
          "textSize": 24
        },
        {
          "type": "layout",
          "orientation": "horizontal",
          "views": [
            {
              "type": "text",
              "label": "Height",
              "mapping": "height"
            },
            {
              "type": "text",
              "label": "Weight",
              "mapping": "weight"
            }
          ]
        },
        {
          "type": "text",
          "label": "Candy",
          "mapping": "candy"
        },
        {
          "type": "text",
          "label": "Weaknesses",
          "mapping": "weaknesses"
        },
        {
          "type": "layout",
          "orientation": "horizontal",
          "views": [
            {
              "type": "text",
              "label": "Egg",
              "mapping": "egg"
            },
            {
              "type": "text",
              "label": "Spawn time",
              "mapping": "spawn_time"
            }
          ]
        },
        {
          "type": "text",
          "label": "Spawn chance",
          "title": "${spawn_chance}%"
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "show_pokemon_detail",
      "type": "click",
      "event": {
        "type": "show",
        "view": {
          "id": "pokemon_detail"
        }
      }
    }
  ]
}
