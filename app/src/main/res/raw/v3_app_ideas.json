{
  "schemaVersion": 3,
  "name": "App ideas",
  "icon": "💡",
  "author": "Appkin",
  "version": "1.0.0",
  "mainView": {
    "type": "layout",
    "views": [
      {
        "type": "button",
        "title": "New app",
        "icon": "add",
        "action": {
          "id": "new_app",
          "event": {
            "type": "show",
            "view": {
              "ref": "new_app"
            },
            "title": "New app"
          }
        }
      },
      {
        "type": "list",
        "stored": {
          "collection": "apps"
        },
        "emptyText": "No apps yet: tap New app to add one.",
        "action": {
          "id": "open_app",
          "event": {
            "type": "show",
            "view": {
              "ref": "app"
            },
            "title": "${name}"
          }
        },
        "itemView": {
          "type": "layout",
          "views": [
            {
              "type": "text",
              "mapping": "name",
              "textStyle": "bold",
              "textSize": 17
            },
            {
              "type": "text",
              "mapping": "description",
              "textSize": 14
            }
          ]
        },
        "swipeToStart": {
          "id": "delete_app",
          "event": {
            "type": "alert",
            "value": "Delete ${name} and its ideas?",
            "thenDoOK": {
              "type": "delete",
              "collection": "apps",
              "thenDo": {
                "type": "delete",
                "collection": "ideas",
                "where": {
                  "appId": "${id}"
                }
              }
            }
          }
        }
      }
    ]
  },
  "views": [
    {
      "id": "new_app",
      "type": "layout",
      "views": [
        {
          "type": "form",
          "buttonTitle": "Add app",
          "formElements": [
            {
              "type": "text",
              "mapping": "name",
              "title": "Name",
              "mandatory": true
            },
            {
              "type": "text",
              "mapping": "description",
              "title": "Description",
              "multiline": true,
              "description": "What the app is about, in a line or two"
            }
          ],
          "action": {
            "id": "add_app",
            "event": {
              "type": "save",
              "collection": "apps",
              "thenDo": {
                "type": "back"
              }
            }
          }
        }
      ]
    },
    {
      "id": "app",
      "type": "layout",
      "views": [
        {
          "type": "button",
          "title": "New idea",
          "icon": "add",
          "action": {
            "id": "new_idea",
            "event": {
              "type": "show",
              "view": {
                "ref": "new_idea"
              },
              "title": "New idea for ${name}"
            }
          }
        },
        {
          "type": "list",
          "stored": {
            "collection": "ideas",
            "where": {
              "appId": "${id}"
            },
            "sortOptions": [
              {
                "title": "Priority",
                "sort": [
                  {
                    "by": "done",
                    "order": [
                      "false",
                      "true"
                    ]
                  },
                  {
                    "by": "priority",
                    "order": [
                      "High",
                      "Medium",
                      "Low"
                    ]
                  }
                ]
              },
              {
                "title": "Newest",
                "sort": [
                  {
                    "by": "done",
                    "order": [
                      "false",
                      "true"
                    ]
                  },
                  {
                    "by": "createdAt",
                    "descending": true
                  }
                ]
              },
              {
                "title": "Changed",
                "sort": [
                  {
                    "by": "updatedAt",
                    "descending": true
                  },
                  {
                    "by": "createdAt",
                    "descending": true
                  }
                ]
              }
            ],
            "filterBy": "tags"
          },
          "emptyText": "No ideas for ${name} yet.",
          "itemView": {
            "type": "layout",
            "views": [
              {
                "type": "layout",
                "orientation": "horizontal",
                "views": [
                  {
                    "type": "text",
                    "title": "${title}",
                    "textStyle": "bold",
                    "textSize": 17
                  },
                  {
                    "type": "button",
                    "icon": "open",
                    "label": "Open the link of ${title}",
                    "visibleIf": "link",
                    "action": {
                      "id": "open_link",
                      "event": {
                        "type": "open",
                        "url": "${link}"
                      }
                    }
                  },
                  {
                    "type": "button",
                    "icon": "share",
                    "label": "Share ${title}",
                    "action": {
                      "id": "share_idea",
                      "event": {
                        "type": "share",
                        "text": "${title}\n${description}\n${link}",
                        "photos": "photos"
                      }
                    }
                  }
                ]
              },
              {
                "type": "text",
                "mapping": "description",
                "textSize": 14
              },
              {
                "type": "image",
                "mapping": "photos",
                "size": {
                  "height": 64
                },
                "visibleIf": "photos"
              },
              {
                "type": "text",
                "title": "${priority} priority",
                "textSize": 13,
                "textStyle": "bold"
              },
              {
                "type": "text",
                "textSize": 13,
                "visibleIf": "done",
                "title": "✓ Done"
              },
              {
                "type": "text",
                "title": "Tags: ${tags}",
                "textSize": 13,
                "visibleIf": "tags"
              },
              {
                "type": "text",
                "title": "Added ${createdAt|ago}",
                "textSize": 12,
                "visibleIf": "!updatedAt"
              },
              {
                "type": "text",
                "title": "Added ${createdAt|ago} · changed ${updatedAt|ago}",
                "textSize": 12,
                "visibleIf": "updatedAt"
              }
            ]
          },
          "action": {
            "id": "edit_idea",
            "event": {
              "type": "show",
              "view": {
                "ref": "idea"
              },
              "title": "Edit idea"
            }
          },
          "swipeToStart": {
            "id": "delete_idea",
            "event": {
              "type": "alert",
              "value": "Delete ${title}?",
              "thenDoOK": {
                "type": "delete",
                "collection": "ideas"
              }
            }
          },
          "swipeToEnd": {
            "id": "done_idea",
            "event": {
              "type": "update",
              "collection": "ideas",
              "fields": {
                "done": true
              }
            }
          }
        }
      ]
    },
    {
      "id": "new_idea",
      "type": "layout",
      "views": [
        {
          "type": "form",
          "buttonTitle": "Add idea",
          "formElements": [
            {
              "type": "text",
              "mapping": "title",
              "title": "Title",
              "mandatory": true,
              "multiline": true
            },
            {
              "type": "text",
              "mapping": "description",
              "title": "Description",
              "multiline": true
            },
            {
              "type": "selector",
              "mapping": "priority",
              "title": "Priority",
              "options": [
                "High",
                "Medium",
                "Low"
              ],
              "selection": "Medium",
              "mandatory": true
            },
            {
              "type": "tags",
              "mapping": "tags",
              "title": "Tags",
              "placeholder": "watch, ui, …",
              "description": "Type a tag and press Enter"
            },
            {
              "type": "text",
              "mapping": "link",
              "title": "Link",
              "textType": "url",
              "placeholder": "https://…",
              "description": "A mockup, a Play listing, anything to open later"
            },
            {
              "type": "photos",
              "mapping": "photos",
              "title": "Photos"
            }
          ],
          "action": {
            "id": "add_idea",
            "event": {
              "type": "save",
              "collection": "ideas",
              "fields": {
                "appId": "${id}",
                "done": false
              },
              "thenDo": {
                "type": "back"
              }
            }
          }
        }
      ]
    },
    {
      "id": "idea",
      "type": "layout",
      "views": [
        {
          "type": "form",
          "buttonTitle": "Save changes",
          "formElements": [
            {
              "type": "text",
              "mapping": "title",
              "title": "Title",
              "mandatory": true,
              "multiline": true
            },
            {
              "type": "text",
              "mapping": "description",
              "title": "Description",
              "multiline": true
            },
            {
              "type": "selector",
              "mapping": "priority",
              "title": "Priority",
              "options": [
                "High",
                "Medium",
                "Low"
              ],
              "selection": "Medium",
              "mandatory": true
            },
            {
              "type": "tags",
              "mapping": "tags",
              "title": "Tags",
              "placeholder": "watch, ui, …",
              "description": "Type a tag and press Enter"
            },
            {
              "type": "text",
              "mapping": "link",
              "title": "Link",
              "textType": "url",
              "placeholder": "https://…",
              "description": "A mockup, a Play listing, anything to open later"
            },
            {
              "type": "photos",
              "mapping": "photos",
              "title": "Photos"
            },
            {
              "type": "checkbox",
              "mapping": "done",
              "title": "Done"
            }
          ],
          "action": {
            "id": "save_idea",
            "event": {
              "type": "update",
              "collection": "ideas",
              "thenDo": {
                "type": "back"
              }
            }
          }
        }
      ]
    }
  ]
}
