{
  "schemaVersion": 3,
  "name": "App ideas",
  "icon": "💡",
  "author": "Appkin",
  "version": "1.0.0",
  "mainView": {
    "type": "layout",
    "views": [
      {
        "type": "form",
        "title": "New app",
        "buttonTitle": "Add app",
        "formElements": [
          {
            "type": "text",
            "mapping": "name",
            "title": "Name",
            "mandatory": true
          }
        ],
        "action": {
          "id": "add_app",
          "event": {
            "type": "save",
            "collection": "apps"
          }
        }
      },
      {
        "type": "list",
        "stored": {
          "collection": "apps"
        },
        "emptyText": "No apps yet: add one above.",
        "action": {
          "id": "open_app",
          "event": {
            "type": "show",
            "view": {
              "ref": "app"
            },
            "title": "${name}"
          }
        },
        "itemView": {
          "type": "text",
          "mapping": "name",
          "textStyle": "bold"
        },
        "swipeToStart": {
          "id": "delete_app",
          "event": {
            "type": "alert",
            "value": "Delete ${name} and its ideas?",
            "thenDoOK": {
              "type": "delete",
              "collection": "apps",
              "thenDo": {
                "type": "delete",
                "collection": "ideas",
                "where": {
                  "appId": "${id}"
                }
              }
            }
          }
        }
      }
    ]
  },
  "views": [
    {
      "id": "app",
      "type": "layout",
      "views": [
        {
          "type": "button",
          "title": "New idea",
          "icon": "add",
          "action": {
            "id": "new_idea",
            "event": {
              "type": "show",
              "view": {
                "ref": "new_idea"
              },
              "title": "New idea for ${name}"
            }
          }
        },
        {
          "type": "list",
          "stored": {
            "collection": "ideas",
            "where": {
              "appId": "${id}"
            },
            "sort": [
              {
                "by": "done",
                "order": [
                  "false",
                  "true"
                ]
              },
              {
                "by": "priority",
                "order": [
                  "High",
                  "Medium",
                  "Low"
                ]
              }
            ]
          },
          "emptyText": "No ideas for ${name} yet.",
          "itemView": {
            "type": "layout",
            "views": [
              {
                "type": "layout",
                "orientation": "horizontal",
                "views": [
                  {
                    "type": "text",
                    "title": "${title}",
                    "textStyle": "bold",
                    "textSize": 17
                  },
                  {
                    "type": "button",
                    "icon": "copy",
                    "label": "Copy ${title}",
                    "action": {
                      "id": "copy_idea",
                      "event": {
                        "type": "copy",
                        "text": "${title}\n${description}\nPriority: ${priority}\nAn idea for my app ${appName}"
                      }
                    }
                  }
                ]
              },
              {
                "type": "text",
                "mapping": "description",
                "textSize": 14
              },
              {
                "type": "image",
                "mapping": "photos",
                "size": {
                  "height": 64
                },
                "visibleIf": "photos"
              },
              {
                "type": "text",
                "title": "${priority} priority",
                "textSize": 13,
                "textStyle": "bold",
                "visibleIf": "priority"
              },
              {
                "type": "text",
                "title": "✓ Done",
                "textSize": 13,
                "visibleIf": "done"
              }
            ]
          },
          "action": {
            "id": "edit_idea",
            "event": {
              "type": "show",
              "view": {
                "ref": "idea"
              },
              "title": "Edit idea"
            }
          },
          "swipeToStart": {
            "id": "delete_idea",
            "event": {
              "type": "alert",
              "value": "Delete ${title}?",
              "thenDoOK": {
                "type": "delete",
                "collection": "ideas"
              }
            }
          },
          "swipeToEnd": {
            "id": "done_idea",
            "event": {
              "type": "update",
              "collection": "ideas",
              "fields": {
                "done": true
              }
            }
          }
        }
      ]
    },
    {
      "id": "new_idea",
      "type": "layout",
      "views": [
        {
          "type": "form",
          "buttonTitle": "Add idea",
          "formElements": [
            {
              "type": "text",
              "mapping": "title",
              "title": "Title",
              "mandatory": true,
              "multiline": true
            },
            {
              "type": "text",
              "mapping": "description",
              "title": "Description",
              "multiline": true
            },
            {
              "type": "selector",
              "mapping": "priority",
              "title": "Priority",
              "options": [
                "High",
                "Medium",
                "Low"
              ],
              "selection": "Medium",
              "mandatory": true
            },
            {
              "type": "photos",
              "mapping": "photos",
              "title": "Photos"
            }
          ],
          "action": {
            "id": "add_idea",
            "event": {
              "type": "save",
              "collection": "ideas",
              "fields": {
                "appId": "${id}",
                "done": false,
                "appName": "${name}"
              },
              "thenDo": {
                "type": "back"
              }
            }
          }
        }
      ]
    },
    {
      "id": "idea",
      "type": "layout",
      "views": [
        {
          "type": "form",
          "buttonTitle": "Save changes",
          "formElements": [
            {
              "type": "text",
              "mapping": "title",
              "title": "Title",
              "mandatory": true,
              "multiline": true
            },
            {
              "type": "text",
              "mapping": "description",
              "title": "Description",
              "multiline": true
            },
            {
              "type": "selector",
              "mapping": "priority",
              "title": "Priority",
              "options": [
                "High",
                "Medium",
                "Low"
              ],
              "selection": "Medium",
              "mandatory": true
            },
            {
              "type": "photos",
              "mapping": "photos",
              "title": "Photos"
            },
            {
              "type": "checkbox",
              "mapping": "done",
              "title": "Done"
            }
          ],
          "action": {
            "id": "save_idea",
            "event": {
              "type": "update",
              "collection": "ideas",
              "thenDo": {
                "type": "back"
              }
            }
          }
        }
      ]
    }
  ]
}
