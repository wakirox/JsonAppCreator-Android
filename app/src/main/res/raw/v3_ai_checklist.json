{
  "schemaVersion": 3,
  "name": "Budapest checklist",
  "icon": "🇭🇺",
  "author": "Appkin",
  "version": "1.0.0",
  "mainView": {
    "type": "list",
    "stored": {
      "collection": "places",
      "unique": "key",
      "sort": [
        {
          "by": "visited"
        },
        {
          "by": "order"
        }
      ],
      "initialItems": [
        {
          "key": "parliament",
          "name": "Parliament",
          "description": "The Gothic Revival seat of the National Assembly, on the Danube.",
          "tickets": "https://www.parlament.hu/web/visitor-centre",
          "order": 1,
          "visited": false
        },
        {
          "key": "bastion",
          "name": "Fisherman's Bastion",
          "description": "Neo-Gothic terraces with the best view over Pest.",
          "order": 2,
          "visited": false
        },
        {
          "key": "matthias",
          "name": "Matthias Church",
          "description": "Coloured roof tiles in the heart of the Castle District.",
          "tickets": "https://www.matyas-templom.hu/",
          "order": 3,
          "visited": false
        }
      ]
    },
    "itemView": {
      "type": "layout",
      "views": [
        {
          "type": "check",
          "mapping": "visited",
          "title": "${name}",
          "action": {
            "ref": "tick"
          }
        }
      ]
    },
    "action": {
      "id": "open_place",
      "event": {
        "type": "show",
        "title": "${name}",
        "view": {
          "ref": "place"
        }
      }
    }
  },
  "views": [
    {
      "id": "place",
      "type": "layout",
      "views": [
        {
          "type": "text",
          "label": "${name}",
          "title": "${description}",
          "labelStyle": "bold"
        },
        {
          "type": "check",
          "mapping": "visited",
          "title": "Visited",
          "action": {
            "ref": "tick"
          }
        },
        {
          "type": "button",
          "title": "Tickets (official site)",
          "icon": "open",
          "visibleIf": "tickets",
          "action": {
            "id": "tickets",
            "event": {
              "type": "open",
              "url": "${tickets}"
            }
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "tick",
      "event": {
        "type": "update",
        "collection": "places"
      }
    }
  ]
}
