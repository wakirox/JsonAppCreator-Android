{
  "schemaVersion": 3,
  "name": "ART EXPLORER",
  "icon": "🏛️",
  "version": "1.0",
  "author": "Appkin",
  "changelog": "A museum collection, live: public-domain artworks from the Cleveland Museum of Art's Open Access API (CC0 data and images). Search it, browse it by type, read about a work and its artist, and plan a visit in your calendar.",
  "mainView": {
    "id": "explorer_home",
    "type": "layout",
    "views": [
      {
        "type": "text",
        "label": "Art Explorer",
        "title": "Thousands of public-domain artworks, live from the Cleveland Museum of Art. Swipe a row, tap a work, or search the whole collection.",
        "textStyle": "bold",
        "textSize": 18
      },
      {
        "type": "text",
        "label": "Highlights",
        "title": "The museum's most celebrated works"
      },
      {
        "type": "list",
        "orientation": "horizontal",
        "initData": {
          "url": "https://openaccess-api.clevelandart.org/api/artworks/?cc0=1&has_image=1&fields=id,title,description,creation_date,images,creators,did_you_know,technique,culture,measurements,department,current_location,url,tombstone&highlight=1&limit=20",
          "method": "get"
        },
        "mapping": "data",
        "action": {
          "ref": "open_artwork"
        },
        "itemView": {
          "ref": "artwork_tile"
        }
      },
      {
        "type": "form",
        "id": "search_form",
        "title": "Search the collection",
        "buttonTitle": "Search",
        "formElements": [
          {
            "type": "text",
            "mapping": "q",
            "title": "Search",
            "placeholder": "Monet, armor, cats…",
            "description": "An artist, a subject or a place",
            "mandatory": true
          }
        ],
        "action": {
          "ref": "search"
        }
      },
      {
        "type": "form",
        "id": "browse_form",
        "title": "Browse by type",
        "buttonTitle": "Browse",
        "formElements": [
          {
            "type": "selector",
            "mapping": "type",
            "title": "Type",
            "options": [
              {
                "label": "Any type",
                "value": ""
              },
              "Painting",
              "Drawing",
              "Print",
              "Photograph",
              "Sculpture",
              "Ceramic",
              "Glass",
              "Jewelry",
              "Textile",
              "Arms and Armor",
              "Manuscript"
            ],
            "selection": "Painting",
            "mandatory": true
          }
        ],
        "action": {
          "ref": "browse"
        }
      },
      {
        "type": "text",
        "label": "Japanese prints",
        "title": "Woodblock prints from Edo-period Japan"
      },
      {
        "type": "list",
        "orientation": "horizontal",
        "initData": {
          "url": "https://openaccess-api.clevelandart.org/api/artworks/?cc0=1&has_image=1&fields=id,title,description,creation_date,images,creators,did_you_know,technique,culture,measurements,department,current_location,url,tombstone&department=Japanese%20Art&type=Print&limit=12",
          "method": "get"
        },
        "mapping": "data",
        "action": {
          "ref": "open_artwork"
        },
        "itemView": {
          "ref": "artwork_tile"
        }
      },
      {
        "type": "text",
        "label": "Ancient Egypt",
        "title": "Amulets, statues and coffins, some over 4,000 years old"
      },
      {
        "type": "list",
        "orientation": "horizontal",
        "initData": {
          "url": "https://openaccess-api.clevelandart.org/api/artworks/?cc0=1&has_image=1&fields=id,title,description,creation_date,images,creators,did_you_know,technique,culture,measurements,department,current_location,url,tombstone&department=Egyptian%20and%20Ancient%20Near%20Eastern%20Art&limit=12",
          "method": "get"
        },
        "mapping": "data",
        "action": {
          "ref": "open_artwork"
        },
        "itemView": {
          "ref": "artwork_tile"
        }
      },
      {
        "type": "text",
        "label": "Arms and armor",
        "title": "Helmets, swords and armor for man and horse"
      },
      {
        "type": "list",
        "orientation": "horizontal",
        "initData": {
          "url": "https://openaccess-api.clevelandart.org/api/artworks/?cc0=1&has_image=1&fields=id,title,description,creation_date,images,creators,did_you_know,technique,culture,measurements,department,current_location,url,tombstone&type=Arms%20and%20Armor&limit=12",
          "method": "get"
        },
        "mapping": "data",
        "action": {
          "ref": "open_artwork"
        },
        "itemView": {
          "ref": "artwork_tile"
        }
      },
      {
        "type": "text",
        "label": "European paintings",
        "title": "From the Impressionists to the early 1900s"
      },
      {
        "type": "list",
        "orientation": "horizontal",
        "initData": {
          "url": "https://openaccess-api.clevelandart.org/api/artworks/?cc0=1&has_image=1&fields=id,title,description,creation_date,images,creators,did_you_know,technique,culture,measurements,department,current_location,url,tombstone&department=Modern%20European%20Painting%20and%20Sculpture&type=Painting&limit=12",
          "method": "get"
        },
        "mapping": "data",
        "action": {
          "ref": "open_artwork"
        },
        "itemView": {
          "ref": "artwork_tile"
        }
      },
      {
        "type": "text",
        "title": "Data and images: Cleveland Museum of Art Open Access (CC0). Art Explorer isn't affiliated with the museum.\nhttps://openaccess-api.clevelandart.org/",
        "textStyle": "italic"
      }
    ]
  },
  "views": [
    {
      "id": "artwork_tile",
      "type": "layout",
      "orientation": "vertical",
      "views": [
        {
          "type": "image",
          "url": "${images.web.url}",
          "size": {
            "width": 150,
            "height": 150
          },
          "action": {
            "ref": "open_artwork"
          }
        },
        {
          "type": "text",
          "title": "${title}",
          "size": {
            "width": 150,
            "height": 48
          }
        }
      ]
    },
    {
      "id": "artwork_row",
      "type": "layout",
      "orientation": "horizontal",
      "views": [
        {
          "type": "image",
          "url": "${images.web.url}",
          "size": {
            "width": 112,
            "height": 112
          }
        },
        {
          "type": "text",
          "label": "${title}",
          "title": "${creation_date}"
        }
      ]
    },
    {
      "id": "artwork_card",
      "type": "layout",
      "orientation": "vertical",
      "views": [
        {
          "type": "image",
          "url": "${images.web.url}",
          "size": {
            "height": 160
          }
        },
        {
          "type": "text",
          "title": "${title}",
          "size": {
            "height": 48
          }
        }
      ]
    },
    {
      "id": "artwork_detail",
      "type": "layout",
      "views": [
        {
          "type": "image",
          "url": "${images.web.url}",
          "size": {
            "height": 320
          },
          "scale": "fit"
        },
        {
          "type": "text",
          "label": "${title}",
          "title": "${creation_date}",
          "textSize": 24,
          "labelStyle": "bold"
        },
        {
          "type": "text",
          "label": "Artist (tap for more)",
          "mapping": "creators.0.description",
          "visibleIf": "creators",
          "action": {
            "ref": "open_artist"
          },
          "labelStyle": "bold"
        },
        {
          "type": "text",
          "label": "Did you know?",
          "mapping": "did_you_know",
          "textStyle": "italic",
          "labelStyle": "bold"
        },
        {
          "type": "text",
          "label": "About this work",
          "mapping": "description",
          "format": "html",
          "labelStyle": "bold"
        },
        {
          "type": "text",
          "label": "Technique",
          "mapping": "technique",
          "labelStyle": "bold"
        },
        {
          "type": "text",
          "label": "Culture",
          "mapping": "culture",
          "labelStyle": "bold"
        },
        {
          "type": "text",
          "label": "Size",
          "mapping": "measurements",
          "labelStyle": "bold"
        },
        {
          "type": "text",
          "label": "Collection",
          "mapping": "department",
          "labelStyle": "bold"
        },
        {
          "type": "text",
          "label": "On view",
          "mapping": "current_location",
          "labelStyle": "bold"
        },
        {
          "type": "layout",
          "orientation": "horizontal",
          "views": [
            {
              "type": "button",
              "title": "Museum label",
              "action": {
                "ref": "museum_label"
              }
            },
            {
              "type": "button",
              "title": "Plan a visit",
              "visibleIf": "current_location",
              "action": {
                "ref": "plan_visit"
              }
            }
          ]
        },
        {
          "type": "layout",
          "orientation": "horizontal",
          "views": [
            {
              "type": "button",
              "title": "Museum page",
              "visibleIf": "url",
              "action": {
                "ref": "museum_page"
              }
            },
            {
              "type": "button",
              "title": "Share",
              "action": {
                "ref": "share_artwork"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "artist_detail",
      "type": "layout",
      "views": [
        {
          "type": "text",
          "title": "${name}",
          "textStyle": "bold",
          "textSize": 26
        },
        {
          "type": "text",
          "mapping": "description"
        },
        {
          "type": "text",
          "mapping": "biography"
        },
        {
          "type": "button",
          "title": "Their works with images",
          "action": {
            "ref": "artist_works"
          }
        },
        {
          "type": "text",
          "label": "Everything by them in the collection",
          "visibleIf": "artworks",
          "title": "Tap one to open it.",
          "textStyle": "bold"
        },
        {
          "type": "list",
          "mapping": "artworks",
          "action": {
            "ref": "open_collection_work"
          },
          "itemView": {
            "id": "collection_work",
            "type": "layout",
            "views": [
              {
                "type": "text",
                "label": "${title}",
                "mapping": "tombstone"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "search_results",
      "type": "layout",
      "views": [
        {
          "type": "text",
          "label": "Results for “${q}”",
          "visibleIf": "q",
          "textStyle": "bold"
        },
        {
          "type": "text",
          "label": "Works by ${name}",
          "visibleIf": "name",
          "textStyle": "bold"
        },
        {
          "type": "text",
          "title": "Public-domain works with images. Tap one to open it; more load as you scroll."
        },
        {
          "type": "list",
          "mapping": "data",
          "emptyText": "Nothing with an image here. Try other words.",
          "initData": {
            "url": "https://openaccess-api.clevelandart.org/api/artworks/?cc0=1&has_image=1&fields=id,title,description,creation_date,images,creators,did_you_know,technique,culture,measurements,department,current_location,url,tombstone&q=${q}&type=${type}&artists=${name}&limit=40",
            "method": "get",
            "nextPage": {
              "parameter": "skip",
              "step": 40
            }
          },
          "action": {
            "ref": "open_artwork"
          },
          "itemView": {
            "ref": "artwork_row"
          }
        }
      ]
    },
    {
      "id": "browse_results",
      "type": "layout",
      "views": [
        {
          "type": "text",
          "label": "${type}",
          "visibleIf": "type",
          "textStyle": "bold"
        },
        {
          "type": "text",
          "label": "All types",
          "visibleIf": "!type",
          "textStyle": "bold"
        },
        {
          "type": "text",
          "title": "Public-domain works with images. Tap one to open it; more load as you scroll."
        },
        {
          "type": "list",
          "mapping": "data",
          "orientation": "grid",
          "columns": 2,
          "emptyText": "Nothing with an image here. Try other words.",
          "initData": {
            "url": "https://openaccess-api.clevelandart.org/api/artworks/?cc0=1&has_image=1&fields=id,title,description,creation_date,images,creators,did_you_know,technique,culture,measurements,department,current_location,url,tombstone&q=${q}&type=${type}&artists=${name}&limit=40",
            "method": "get",
            "nextPage": {
              "parameter": "skip",
              "step": 40
            }
          },
          "action": {
            "ref": "open_artwork"
          },
          "itemView": {
            "ref": "artwork_card"
          }
        }
      ]
    },
    {
      "id": "visit_planner",
      "type": "layout",
      "views": [
        {
          "type": "text",
          "label": "Plan a visit",
          "title": "Pick a day and a time, and Appkin opens your calendar with the visit filled in. Check the museum's website for opening hours and what's on view.\nhttps://www.clevelandart.org/visit"
        },
        {
          "type": "form",
          "id": "visit_form",
          "buttonTitle": "Add to calendar",
          "formElements": [
            {
              "type": "text",
              "mapping": "title",
              "title": "Artwork to see",
              "mandatory": true
            },
            {
              "type": "date",
              "mapping": "date",
              "title": "Day",
              "mandatory": true
            },
            {
              "type": "time",
              "mapping": "time",
              "title": "Time",
              "value": "11:00",
              "mandatory": true
            },
            {
              "type": "hidden",
              "mapping": "url"
            }
          ],
          "action": {
            "ref": "add_visit"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "open_artwork",
      "type": "click",
      "event": {
        "type": "show",
        "view": {
          "ref": "artwork_detail"
        },
        "title": "${department}"
      }
    },
    {
      "id": "search",
      "type": "click",
      "event": {
        "type": "show",
        "view": {
          "ref": "search_results"
        },
        "title": "Search"
      }
    },
    {
      "id": "browse",
      "type": "click",
      "event": {
        "type": "show",
        "view": {
          "ref": "browse_results"
        },
        "title": "Browse"
      }
    },
    {
      "id": "open_artist",
      "type": "click",
      "event": {
        "type": "rest",
        "method": "get",
        "url": "https://openaccess-api.clevelandart.org/api/creators/${creators.0.id}",
        "thenDo": {
          "type": "show",
          "mapping": "data",
          "view": {
            "ref": "artist_detail"
          },
          "title": "Artist"
        },
        "onError": {
          "type": "alert",
          "value": "The museum couldn't send this artist's page (${error.message}). Try again in a moment."
        }
      }
    },
    {
      "id": "artist_works",
      "type": "click",
      "event": {
        "type": "show",
        "view": {
          "ref": "search_results"
        },
        "title": "Works by ${name}"
      }
    },
    {
      "id": "museum_label",
      "type": "click",
      "event": {
        "type": "alert",
        "value": "${tombstone}"
      }
    },
    {
      "id": "museum_page",
      "type": "click",
      "event": {
        "type": "open",
        "url": "${url}"
      }
    },
    {
      "id": "share_artwork",
      "type": "click",
      "event": {
        "type": "share",
        "text": "${title} (${creation_date}), Cleveland Museum of Art\n${url}"
      }
    },
    {
      "id": "plan_visit",
      "type": "click",
      "event": {
        "type": "show",
        "view": {
          "ref": "visit_planner"
        },
        "title": "Plan a visit"
      }
    },
    {
      "id": "add_visit",
      "type": "click",
      "event": {
        "type": "calendar",
        "title": "Cleveland Museum of Art: ${title}",
        "date": "${date}",
        "time": "${time}",
        "durationMinutes": 120,
        "location": "Cleveland Museum of Art, 11150 East Blvd, Cleveland, OH 44106",
        "description": "Go and see ${title}.\n${url}"
      }
    },
    {
      "id": "open_collection_work",
      "type": "click",
      "event": {
        "type": "rest",
        "method": "get",
        "url": "https://openaccess-api.clevelandart.org/api/artworks/${id}",
        "thenDo": {
          "type": "show",
          "mapping": "data",
          "view": {
            "ref": "artwork_detail"
          },
          "title": "${department}"
        },
        "onError": {
          "type": "alert",
          "value": "The museum couldn't send this work (${error.message}). Try again in a moment."
        }
      }
    }
  ]
}
