<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:icon="@mipmap/ic_appkin"
            android:label="@string/app_name"
            android:usesCleartextTraffic="false"
            android:roundIcon="@mipmap/ic_appkin_round"
            android:supportsRtl="true"
            android:name="it.sapienza.appinterpreter.AppRatioApplication"
            android:theme="@style/AppTheme.Launcher">

        <activity
                android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
                android:screenOrientation="unspecified"
                android:name="it.sapienza.appinterpreter.activity.MainActivity"
                android:exported="true"
                />
        <!-- The home page, opened from the launcher. Home-screen shortcuts open MainActivity directly. -->
        <activity
                android:name="it.sapienza.appinterpreter.activity.HomeActivity"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
                android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
                android:theme="@style/AppTheme.Compose"
                android:name="it.sapienza.appinterpreter.activity.PhotoActivity"/>
        <!-- Also the share target for answers from an AI app: shared text or JSON opens in the editor. -->
        <activity
                android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
                android:windowSoftInputMode="adjustResize"
                android:name="it.sapienza.appinterpreter.activity.EditorActivity"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- Makes or changes an app with the user's AI app. -->
        <activity
                android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
                android:windowSoftInputMode="adjustResize"
                android:name="it.sapienza.appinterpreter.activity.AskAiActivity"
                android:exported="false" />

        <activity
                android:name="it.sapienza.appinterpreter.activity.ManageFileInActivity"
                android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- Hands a shared app's file to the app it's sent with. -->
        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.files"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
