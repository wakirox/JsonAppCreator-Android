<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
            android:allowBackup="false"
            android:icon="@mipmap/app_icon2"
            android:label="@string/app_name"
            android:usesCleartextTraffic="false"
            android:roundIcon="@mipmap/app_icon2_round"
            android:supportsRtl="true"
            android:name="it.sapienza.appinterpreter.AppRatioApplication"
            android:theme="@style/AppTheme.Launcher">

        <activity
                android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
                android:screenOrientation="unspecified"
                android:name="it.sapienza.appinterpreter.activity.MainActivity"
                android:exported="true"
                >
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>

            </intent-filter>
        </activity>
        <activity
                android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
                android:theme="@style/AppTheme.Compose"
                android:name="it.sapienza.appinterpreter.activity.PhotoActivity"/>
        <activity
                android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
                android:name="it.sapienza.appinterpreter.activity.PlainTextActivity"/>
        <!-- Also the share target for answers from an AI app: shared text or JSON opens in the editor. -->
        <activity
                android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
                android:windowSoftInputMode="adjustResize"
                android:name="it.sapienza.appinterpreter.activity.EditorActivity"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <activity android:name="it.sapienza.appinterpreter.activity.MyAppsActivity" />

        <activity
                android:name="it.sapienza.appinterpreter.activity.ManageFileInActivity"
                android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

    </application>

</manifest>
