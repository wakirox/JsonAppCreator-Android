{
  "schemaVersion": 3,
  "name": "App ideas",
  "icon": "💡",
  "author": "Appkin",
  "version": "1.0.0",
  "mainView": {
    "type": "layout",
    "views": [
      {
        "type": "form",
        "title": "New app",
        "buttonTitle": "Add app",
        "formElements": [
          { "type": "text", "mapping": "name", "title": "Name", "mandatory": true }
        ],
        "action": { "id": "add_app", "event": { "type": "save", "collection": "apps" } }
      },
      {
        "type": "list",
        "stored": { "collection": "apps" },
        "action": { "id": "open_app", "event": { "type": "show", "view": { "ref": "app" } } },
        "itemView": { "type": "text", "mapping": "name", "textStyle": "bold" }
      }
    ]
  },
  "views": [
    {
      "id": "app",
      "type": "layout",
      "views": [
        { "type": "text", "mapping": "name", "textStyle": "bold", "textSize": 22 },
        {
          "type": "form",
          "title": "New idea",
          "buttonTitle": "Add idea",
          "formElements": [
            { "type": "text", "mapping": "title", "title": "Idea", "mandatory": true }
          ],
          "action": { "id": "add_idea", "event": { "type": "save", "collection": "ideas", "fields": { "appId": "${id}" } } }
        },
        {
          "type": "list",
          "stored": { "collection": "ideas", "where": { "appId": "${id}" } },
          "itemView": { "type": "text", "mapping": "title" }
        }
      ]
    }
  ]
}
