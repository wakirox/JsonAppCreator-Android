{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wakirox/JsonAppCreator-Android/master/schema/v3.schema.json",
  "title": "Appkin configuration v3",
  "description": "Machine-readable contract for an Appkin v3 application. schemaVersion is optional for backward compatibility; new configurations should set it to 3.",
  "type": "object",
  "required": ["name", "version", "mainView"],
  "properties": {
    "schemaVersion": {
      "description": "Configuration-language version. Optional only for compatibility with configurations created before schema versioning was introduced.",
      "const": 3,
      "default": 3
    },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "author": { "$ref": "#/$defs/nullableString" },
    "debugMode": { "type": ["boolean", "null"], "default": false },
    "version": { "$ref": "#/$defs/nonEmptyString" },
    "icon": {
      "type": ["string", "null"],
      "maxLength": 32,
      "description": "One emoji for the app's icon on the home page and the phone's home screen, such as \"🏍️\". Without it, the icon is the name's first letter."
    },
    "changelog": { "$ref": "#/$defs/nullableString" },
    "mainView": { "$ref": "#/$defs/view" },
    "views": {
      "type": "array",
      "description": "Reusable view definitions. References are not valid in this registry.",
      "items": { "$ref": "#/$defs/viewDefinition" },
      "default": []
    },
    "actions": {
      "type": "array",
      "description": "Reusable action definitions. References are not valid in this registry.",
      "items": { "$ref": "#/$defs/actionDefinition" },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "data": {
      "type": ["object", "null"],
      "description": "Arbitrary JSON object made available to mappings and interpolation."
    },
    "visibleIf": {
      "description": "A path in the view's data, such as creators or current_location: the view is shown only when there is a value there that isn't null, empty, false, 0 or an empty array. Start it with ! to show the view only when there isn't. Only presence tests, no expressions.",
      "type": ["string", "null"],
      "pattern": "^!?[^!\\s]+$"
    },
    "size": {
      "type": ["object", "null"],
      "properties": {
        "width": { "type": ["integer", "null"], "minimum": 0 },
        "height": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "view": {
      "description": "A view definition (it has a type), an explicit reference (ref) or a legacy ID-only reference.",
      "if": { "type": "object", "required": ["type"] },
      "then": { "$ref": "#/$defs/viewDefinition" },
      "else": {
        "if": { "type": "object", "required": ["ref"] },
        "then": { "$ref": "#/$defs/explicitViewReference" },
        "else": { "$ref": "#/$defs/legacyViewReference" }
      }
    },
    "explicitViewReference": {
      "title": "Explicit view reference (preferred)",
      "description": "References a reusable root view by ID. New configurations should use this unambiguous form.",
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/nonEmptyString" },
        "visibleIf": { "$ref": "#/$defs/visibleIf" }
      },
      "additionalProperties": false
    },
    "legacyViewReference": {
      "title": "Legacy view reference",
      "description": "Backward-compatible ID-only reference. Prefer the explicit ref property in new configurations.",
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false,
      "deprecated": true
    },
    "viewDefinition": {
      "description": "A view, chosen by its type: only that type's rules apply, so a mistake is reported once.",
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["layout", "text", "button", "image", "list", "form"] } },
      "allOf": [
        { "if": { "properties": { "type": { "const": "layout" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/layoutView" } },
        { "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/textView" } },
        { "if": { "properties": { "type": { "const": "button" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/buttonView" } },
        { "if": { "properties": { "type": { "const": "image" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/imageView" } },
        { "if": { "properties": { "type": { "const": "list" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/listView" } },
        { "if": { "properties": { "type": { "const": "form" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/formView" } }
      ]
    },
    "layoutView": {
      "type": "object",
      "required": ["type", "views"],
      "properties": {
        "type": { "const": "layout" },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "$ref": "#/$defs/action" },
        "mapping": { "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" },
        "visibleIf": { "$ref": "#/$defs/visibleIf" },
        "orientation": {
          "description": "How the child views are arranged; vertical by default",
          "type": ["string", "null"],
          "enum": ["horizontal", "vertical", null],
          "default": "vertical"
        },
        "views": {
          "description": "The child views, in order",
          "type": "array",
          "items": { "$ref": "#/$defs/view" }
        }
      },
      "additionalProperties": false
    },
    "textView": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "text" },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "$ref": "#/$defs/action" },
        "mapping": { "description": "Path of a value in the current data to show as the text, such as owner.name", "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" },
        "visibleIf": { "$ref": "#/$defs/visibleIf" },
        "textSize": { "description": "Font size in sp", "type": ["number", "null"], "minimum": 0 },
        "size": { "$ref": "#/$defs/size" },
        "textStyle": {
          "type": ["string", "null"],
          "enum": ["regular", "italic", "bold", null],
          "default": "regular"
        },
        "title": { "description": "The text, when no mapping value is shown", "$ref": "#/$defs/nullableString" },
        "label": { "description": "First line of the text view, shown above the text", "$ref": "#/$defs/nullableString" },
        "labelStyle": {
          "description": "The label's own style, so a bold heading needn't make its text bold; without it the label looks like the text",
          "type": ["string", "null"],
          "enum": ["regular", "italic", "bold", null]
        },
        "format": {
          "description": "plain (default), or html: simple HTML in the text (<b>, <i>, <em>, <strong>, <u>, <br>, <p>, <a href>), such as a museum's descriptions",
          "type": ["string", "null"],
          "enum": ["plain", "html", null],
          "default": "plain"
        },
        "showWhenEmpty": {
          "description": "Show the label even when the mapping or title has nothing to show. By default such a text view isn't drawn at all.",
          "type": ["boolean", "null"],
          "default": false
        }
      },
      "additionalProperties": false
    },
    "buttonView": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "button" },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "description": "What a tap does", "$ref": "#/$defs/action" },
        "mapping": { "description": "Path of a value in the current data to use as the button's text", "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" },
        "visibleIf": { "$ref": "#/$defs/visibleIf" },
        "textSize": { "type": ["number", "null"], "minimum": 0 },
        "size": { "$ref": "#/$defs/size" },
        "textStyle": {
          "type": ["string", "null"],
          "enum": ["regular", "italic", "bold", null],
          "default": "regular"
        },
        "title": { "description": "The button's text", "$ref": "#/$defs/nullableString" },
        "label": { "description": "Not displayed on buttons: use title", "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "imageView": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "image" },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "$ref": "#/$defs/action" },
        "mapping": { "description": "Path of an image address in the current data", "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" },
        "visibleIf": { "$ref": "#/$defs/visibleIf" },
        "url": { "description": "Image address; may use ${field} placeholders", "$ref": "#/$defs/nullableString" },
        "size": { "$ref": "#/$defs/size" },
        "scale": {
          "description": "crop (default): the picture fills its space and its edges may be cut; fit: the whole picture shows, inside its space",
          "type": ["string", "null"],
          "enum": ["crop", "fit", null],
          "default": "crop"
        }
      },
      "additionalProperties": false
    },
    "listView": {
      "type": "object",
      "required": ["type", "itemView"],
      "properties": {
        "type": { "const": "list" },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "description": "What tapping an item does; its event receives that item", "$ref": "#/$defs/action" },
        "mapping": { "description": "Path of the array of objects to show, in data or in the initData response", "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" },
        "visibleIf": { "$ref": "#/$defs/visibleIf" },
        "itemView": { "description": "The view repeated for each item; its mappings and placeholders refer to that item", "$ref": "#/$defs/view" },
        "initData": {
          "description": "A REST request whose JSON response is the list's data",
          "oneOf": [
            { "$ref": "#/$defs/initialRestService" },
            { "type": "null" }
          ]
        },
        "orientation": {
          "description": "vertical (default): one item per row; horizontal: a row that scrolls sideways; grid: items side by side in rows of columns",
          "enum": ["horizontal", "vertical", "grid"],
          "default": "vertical"
        },
        "columns": {
          "description": "Items per row of a grid; 2 by default",
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 6
        },
        "emptyText": {
          "description": "What the list says when it has no items, instead of No data available; may use ${field} placeholders",
          "$ref": "#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    },
    "formView": {
      "type": "object",
      "required": ["type", "formElements"],
      "properties": {
        "type": { "const": "form" },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "description": "Runs on submit, with the submitted object as data", "$ref": "#/$defs/action" },
        "mapping": { "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" },
        "visibleIf": { "$ref": "#/$defs/visibleIf" },
        "title": { "description": "Heading above the fields", "$ref": "#/$defs/nullableString" },
        "buttonTitle": { "description": "The submit button's text; Submit by default", "$ref": "#/$defs/nullableString" },
        "formElements": {
          "description": "The fields; each one puts its value under its mapping in the submitted object",
          "type": "array",
          "items": { "$ref": "#/$defs/formElement" }
        }
      },
      "additionalProperties": false
    },
    "formElement": {
      "description": "A form field, chosen by its type.",
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["text", "selector", "date", "time", "checkbox", "hidden"] } },
      "allOf": [
        { "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/textInput" } },
        { "if": { "properties": { "type": { "const": "selector" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/selectorInput" } },
        { "if": { "properties": { "type": { "const": "date" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/dateInput" } },
        { "if": { "properties": { "type": { "const": "checkbox" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/checkboxInput" } },
        { "if": { "properties": { "type": { "const": "time" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/timeInput" } },
        { "if": { "properties": { "type": { "const": "hidden" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/hiddenInput" } }
      ]
    },
    "textInput": {
      "type": "object",
      "required": ["type", "mapping", "title"],
      "properties": {
        "type": { "const": "text" },
        "mapping": { "description": "Key of the submitted object that receives the value", "$ref": "#/$defs/nonEmptyString" },
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/nullableString" },
        "mandatory": { "description": "Must be filled in before submitting", "type": ["boolean", "null"], "default": false },
        "placeholder": { "$ref": "#/$defs/nullableString" },
        "value": { "$ref": "#/$defs/nullableString" },
        "textType": {
          "type": ["string", "null"],
          "enum": ["plain", "numeric", "email", "password", null],
          "default": "plain"
        }
      },
      "additionalProperties": false
    },
    "selectorInput": {
      "type": "object",
      "required": ["type", "mapping", "title", "options"],
      "properties": {
        "type": { "const": "selector" },
        "mapping": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/nullableString" },
        "mandatory": { "type": ["boolean", "null"], "default": false },
        "options": {
          "description": "The choices: each is a string, shown and submitted, or { \"label\": shown, \"value\": submitted }, such as { \"label\": \"Any type\", \"value\": \"\" }",
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["value"],
                "properties": {
                  "label": { "description": "What the option shows; its value by default", "type": "string" },
                  "value": { "description": "What the form submits when it's chosen", "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "selection": { "description": "The value chosen at first", "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "dateInput": {
      "type": "object",
      "required": ["type", "mapping", "title"],
      "properties": {
        "type": { "const": "date" },
        "mapping": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/nullableString" },
        "mandatory": { "type": ["boolean", "null"], "default": false },
        "min": { "$ref": "#/$defs/dateValue" },
        "max": { "$ref": "#/$defs/dateValue" },
        "value": { "$ref": "#/$defs/dateValue" }
      },
      "additionalProperties": false
    },
    "dateValue": {
      "description": "A date string accepted by Jackson or an epoch-millisecond number.",
      "type": ["string", "number", "null"]
    },
    "timeInput": {
      "type": "object",
      "description": "A time of day, picked on a clock and submitted as HH:mm, as a calendar event's time takes it.",
      "required": ["type", "mapping", "title"],
      "properties": {
        "type": { "const": "time" },
        "mapping": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/nullableString" },
        "mandatory": { "type": ["boolean", "null"], "default": false },
        "value": {
          "description": "The time at first, HH:mm",
          "type": ["string", "null"],
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
        }
      },
      "additionalProperties": false
    },
    "hiddenInput": {
      "type": "object",
      "description": "A value the form sends without showing it, such as the id of the item on screen.",
      "required": ["type", "mapping"],
      "properties": {
        "type": { "const": "hidden" },
        "mapping": { "description": "Key of the submitted object that receives the value", "$ref": "#/$defs/nonEmptyString" },
        "value": { "description": "The value, sent as text; may use ${field} placeholders filled in from the screen's data. Without it, the data's value at mapping is sent.", "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "checkboxInput": {
      "type": "object",
      "required": ["type", "mapping", "title"],
      "properties": {
        "type": { "const": "checkbox" },
        "mapping": { "description": "Key of the submitted object that receives true or false", "$ref": "#/$defs/nonEmptyString" },
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/nullableString" },
        "mandatory": { "description": "Must be checked before submitting", "type": ["boolean", "null"], "default": false },
        "value": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "action": {
      "description": "An action definition (it has an event), an explicit reference (ref) or a legacy ID-only reference.",
      "if": { "type": "object", "required": ["event"] },
      "then": { "$ref": "#/$defs/actionDefinition" },
      "else": {
        "if": { "type": "object", "required": ["ref"] },
        "then": { "$ref": "#/$defs/explicitActionReference" },
        "else": { "$ref": "#/$defs/legacyActionReference" }
      }
    },
    "explicitActionReference": {
      "title": "Explicit action reference (preferred)",
      "description": "References a reusable root action by ID. New configurations should use this unambiguous form.",
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "legacyActionReference": {
      "title": "Legacy action reference",
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false,
      "deprecated": true
    },
    "actionDefinition": {
      "type": "object",
      "required": ["id", "event"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "data": { "$ref": "#/$defs/data" },
        "type": {
          "enum": ["click", "longclick"],
          "default": "click"
        },
        "event": { "$ref": "#/$defs/event" }
      },
      "additionalProperties": false
    },
    "event": {
      "description": "An event, chosen by its type.",
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["rest", "show", "alert", "calendar", "open", "share"] } },
      "allOf": [
        { "if": { "properties": { "type": { "const": "rest" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/restEvent" } },
        { "if": { "properties": { "type": { "const": "show" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/showEvent" } },
        { "if": { "properties": { "type": { "const": "alert" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/alertEvent" } },
        { "if": { "properties": { "type": { "const": "calendar" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/calendarEvent" } },
        { "if": { "properties": { "type": { "const": "open" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/openEvent" } },
        { "if": { "properties": { "type": { "const": "share" } }, "required": ["type"] }, "then": { "$ref": "#/$defs/shareEvent" } }
      ]
    },
    "restEvent": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "rest" },
        "url": { "description": "HTTPS address; may use ${field} placeholders from the current data", "$ref": "#/$defs/nonEmptyString" },
        "method": {
          "type": ["string", "null"],
          "enum": ["get", "post", null],
          "default": "get"
        },
        "thenDo": {
          "description": "The event to run next, with the JSON response as data",
          "oneOf": [
            { "$ref": "#/$defs/event" },
            { "type": "null" }
          ]
        },
        "mapping": { "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" }
      },
      "additionalProperties": false
    },
    "initialRestService": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "$ref": "#/$defs/nonEmptyString" },
        "method": {
          "type": ["string", "null"],
          "enum": ["get", "post", null],
          "default": "get"
        },
        "thenDo": {
          "oneOf": [
            { "$ref": "#/$defs/event" },
            { "type": "null" }
          ]
        },
        "mapping": { "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" },
        "nextPage": {
          "description": "How the list asks for more items when it nears its end. Either parameter and step: that query parameter (such as skip) grows by step, the page size, until a page has fewer items. Or urlFrom: the path in the response of the next page's URL, until there is none.",
          "type": ["object", "null"],
          "properties": {
            "parameter": { "description": "The query parameter that says where a page starts, such as skip or offset", "$ref": "#/$defs/nonEmptyString" },
            "step": { "description": "How much it grows from page to page: the page size", "type": "integer", "minimum": 1 },
            "urlFrom": { "description": "Path in each response of the next page's URL, such as info.next", "$ref": "#/$defs/nonEmptyString" }
          },
          "oneOf": [
            { "required": ["parameter", "step"], "not": { "required": ["urlFrom"] } },
            { "required": ["urlFrom"], "not": { "anyOf": [ { "required": ["parameter"] }, { "required": ["step"] } ] } }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "showEvent": {
      "type": "object",
      "required": ["type", "view"],
      "properties": {
        "type": { "const": "show" },
        "view": { "description": "The view to open; it receives the current data", "$ref": "#/$defs/view" },
        "mapping": { "description": "Path of the part of the current data the view receives", "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" },
        "title": { "description": "The opened screen's title in the app bar, instead of the app's name; may use ${field} placeholders from the data it receives", "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "calendarEvent": {
      "type": "object",
      "description": "Opens the phone's calendar app on a new event, filled in; the user reviews and saves it there.",
      "required": ["type", "title", "date"],
      "properties": {
        "type": { "const": "calendar" },
        "title": { "description": "The event's title; may use ${field} placeholders", "$ref": "#/$defs/nonEmptyString" },
        "date": { "description": "The day, dd/MM/yyyy; may be a placeholder such as ${date} from a form's date field", "$ref": "#/$defs/nonEmptyString" },
        "time": { "description": "The start time, HH:mm; without it the event lasts all day", "$ref": "#/$defs/nullableString" },
        "durationMinutes": { "description": "How long a timed event lasts; 60 by default", "type": ["integer", "null"], "minimum": 1 },
        "location": { "description": "Where it happens; may use ${field} placeholders", "$ref": "#/$defs/nullableString" },
        "description": { "description": "Notes for the event; may use ${field} placeholders", "$ref": "#/$defs/nullableString" },
        "mapping": { "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" }
      },
      "additionalProperties": false
    },
    "openEvent": {
      "type": "object",
      "description": "Hands an address to another app on the phone: https or http opens the browser, geo: a map, tel: the dialer (nothing is called) and mailto: an email app. No other kinds of address are opened.",
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "open" },
        "url": {
          "description": "An https:, http:, geo:, tel: or mailto: address, or a placeholder holding one, such as ${url}; values placeholders insert are percent-encoded",
          "type": "string",
          "pattern": "^(https?:|geo:|tel:|mailto:|\\$\\{)"
        },
        "mapping": { "description": "Path of the part of the current data the address is filled in from", "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" }
      },
      "additionalProperties": false
    },
    "shareEvent": {
      "type": "object",
      "description": "Opens the phone's share sheet on a text, for the user to send to any app.",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "share" },
        "text": { "description": "What is shared; may use ${field} placeholders, such as \"${title} ${url}\"", "$ref": "#/$defs/nonEmptyString" },
        "mapping": { "description": "Path of the part of the current data the text is filled in from", "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" }
      },
      "additionalProperties": false
    },
    "alertEvent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "alert" },
        "value": { "description": "The message; may use ${field} placeholders", "$ref": "#/$defs/nullableString" },
        "thenDoOK": {
          "description": "The event to run when OK is tapped",
          "oneOf": [
            { "$ref": "#/$defs/event" },
            { "type": "null" }
          ]
        },
        "thenDoKO": {
          "description": "The event to run when the alert is cancelled",
          "oneOf": [
            { "$ref": "#/$defs/event" },
            { "type": "null" }
          ]
        },
        "mapping": { "$ref": "#/$defs/nullableString" },
        "data": { "$ref": "#/$defs/data" }
      },
      "additionalProperties": false
    }
  }
}
